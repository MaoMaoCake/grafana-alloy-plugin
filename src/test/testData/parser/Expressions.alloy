lit_number   = 10
lit_float    = 15.0
lit_string   = "Hello, world!"
lit_null     = null
lit_true     = true

array_expr_trailing = [0, 1, 2, 3,]
object_expr         = { field_a = 1, field_b = 2 }
object_expr_mixed   = { "app.kubernetes.io/name" = "x", bare_key = 1 }

not_something = !true
neg_number    = -5

binop_pow   = 1 ^ 2 ^ 3
mixed_assoc = 1 * 3 + 5 ^ 3 - 2 % 1

field_access      = a.b.c.d
element_access    = a[0][1][2]
call_multiline    = a(
  1,
  2,
  3,
)
mixed_expr = (a.b.c)(1, 3 * some_list[magic_index * 2]).resulting_field
