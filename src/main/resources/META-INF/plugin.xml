<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.maomaocake.grafana-alloy-plugin</id>
    <name>Grafana Alloy</name>
    <vendor url="https://github.com/maomaocake">maomaocake</vendor>

    <description><![CDATA[
        Language support for <a href="https://grafana.com/docs/alloy/latest/">Grafana Alloy</a>
        configuration files (<code>*.alloy</code>).<br>
        <br>
        Features:
        <ul>
          <li>Parser + syntax highlighting (per-namespace colors)</li>
          <li>Completion for components, arguments, and references (port-type-aware)</li>
          <li>Go-to-definition, Find Usages, and Rename for labeled blocks and <code>declare</code> modules</li>
          <li>Inspections: unknown / missing-required arguments, duplicate labels, port-type mismatches, stability warnings</li>
          <li>Inline docs (Ctrl/Cmd-Q) with component / argument / reference details</li>
          <li>Structure view, folding, brace matcher, commenter</li>
        </ul>
        <br>
        This plugin is free and built in my spare time. If it's useful to you, please consider
        sponsoring development: <b><a href="https://ko-fi.com/REPLACE_WITH_YOUR_HANDLE">ko-fi.com/REPLACE_WITH_YOUR_HANDLE</a></b>.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action
            id="GrafanaAlloy.SponsorAction"
            class="com.maomaocake.grafanaalloyplugin.actions.SponsorAction"
            text="Sponsor the Grafana Alloy Plugin"
            description="Open the sponsor page in your browser">
            <add-to-group group-id="HelpMenu" anchor="last"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">

        <fileType
            name="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.AlloyFileType"
            fieldName="INSTANCE"
            language="Alloy"
            extensions="alloy"/>

        <lang.parserDefinition
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.parser.AlloyParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.highlight.AlloySyntaxHighlighterFactory"/>

        <annotator
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.highlight.AlloyNamespaceAnnotator"/>

        <annotator
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.highlight.AlloyReferenceAnnotator"/>

        <annotator
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.highlight.AlloyAttributeKeyAnnotator"/>

        <annotator
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.highlight.AlloyCatalogAnnotator"/>

        <lang.documentationProvider
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.docs.AlloyDocumentationProvider"/>

        <lang.elementManipulator
            forClass="com.maomaocake.grafanaalloyplugin.psi.AlloyOperExpr"
            implementationClass="com.maomaocake.grafanaalloyplugin.psi.AlloyOperExprManipulator"/>

        <lang.elementManipulator
            forClass="com.maomaocake.grafanaalloyplugin.psi.AlloyBlockName"
            implementationClass="com.maomaocake.grafanaalloyplugin.psi.AlloyBlockNameManipulator"/>

        <lang.braceMatcher
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.editor.AlloyBraceMatcher"/>

        <lang.commenter
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.editor.AlloyCommenter"/>

        <lang.foldingBuilder
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.editor.AlloyFoldingBuilder"/>

        <lang.psiStructureViewFactory
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.editor.AlloyStructureViewFactory"/>

        <lang.findUsagesProvider
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.references.AlloyFindUsagesProvider"/>

        <completion.contributor
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.completion.AlloyCompletionContributor"/>

        <typedHandler
            implementation="com.maomaocake.grafanaalloyplugin.completion.AlloyTypedHandler"/>

        <targetElementEvaluator
            language="Alloy"
            implementationClass="com.maomaocake.grafanaalloyplugin.references.AlloyTargetElementEvaluator"/>

        <additionalTextAttributes scheme="Default" file="colorSchemes/AlloyDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/AlloyDarcula.xml"/>
    </extensions>
</idea-plugin>
