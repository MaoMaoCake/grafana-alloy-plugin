<idea-plugin>
    <!--
      Loaded only when `org.jetbrains.plugins.yaml` is present at runtime. Holds every
      extension that touches YAML PSI so the main plugin keeps loading in IDEs that ship
      without YAML support (rare, but possible in stripped-down or custom builds).
    -->
    <extensions defaultExtensionNs="com.intellij">
        <multiHostInjector
            implementation="com.maomaocake.grafanaalloyplugin.injection.AlloyYamlInjector"/>

        <localInspection
            language="yaml"
            shortName="AlloyYamlBlockScalar"
            displayName="Alloy config in quoted scalar"
            groupName="Grafana Alloy"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.maomaocake.grafanaalloyplugin.injection.AlloyYamlBlockScalarInspection"/>
    </extensions>
</idea-plugin>
